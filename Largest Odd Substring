 public static String findLargestOddSubstring(String num) {
    
    int s=num.length();
   // int t=0;
    for(int i=s-1;i>=0;i--){
        char ch=num.charAt(i);
        int k= ch-'0';
        if((k&1)==1){
          
          return num.substring(0,i+1);
        }
    }
        return "-1";
    
 }
