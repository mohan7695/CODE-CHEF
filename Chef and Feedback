import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
    Scanner sc=new Scanner(System.in);
    
    int n=sc.nextInt();
    for(int i=0;i<n;i++){
        String s=sc.next();
        
        
        if(s.contains("010") || s.contains("101")){
            System.out.println("Good");
           
        }else{
            System.out.println("Bad");
        }
    }
    
	}
}
