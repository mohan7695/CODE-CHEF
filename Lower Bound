 static int solve(int[] nums, int x) {
     //write logic here...
     int left=0;
     int right = nums.length;
     
     while(left < right) { 
         int mid = left+(right-left)/2;
         
         
        //  if(nums[mid] == x) {
        //      return mid;
        //  }
        if(nums[mid] < x){
             left=mid+1;
         }
         else{
              right = mid;
         }
     }
         
         return left;
 }
