import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int t = scanner.nextInt();
          // your code goes here
           
        while (t-- > 0) {
            int n = scanner.nextInt();
            int k = scanner.nextInt();
            int[] a = new int[n];
            for (int i = 0; i < n; i++) {
                a[i] = scanner.nextInt();
            }
          
            
            Arrays.sort(a);
             int count=0;
            int total =0;
            for(int i=k;i<a.length-k;i++){
                total+=a[i];
                count++;
            }
        
       double f=(double) total/count;
       System.out.printf("%.6f%n",f);
        }
    }
}
